FROM python:3.12-slim
WORKDIR /app
COPY api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY api/mercury ./mercury
ENV PYTHONUNBUFFERED=1 SIBYL_DB_PATH=/data/memory.db SIBYL_TENANT_ID=mercury
VOLUME ["/data"]
EXPOSE 8000
CMD ["uvicorn", "mercury.main:app", "--host", "0.0.0.0", "--port", "8000"]
